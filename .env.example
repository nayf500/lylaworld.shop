# انسخي هذا الملف باسم .env وعبّئي القيم الحقيقية

# مفاتيح Moyasar (احصلي عليها من https://dashboard.moyasar.com بعد فتح حساب تاجر)
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# كلمة مرور لوحة التحكم — غيّريها فوراً
ADMIN_PASSWORD=change-me-please

# رابط موقعكِ الفعلي بعد الرفع (بدون / في النهاية). يُستخدم في رابط تأكيد الدفع.
SITE_URL=http://localhost:3000

# المنفذ
PORT=3000
